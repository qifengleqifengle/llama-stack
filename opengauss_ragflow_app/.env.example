# Llama Stack
OPENGAUSS_RAGFLOW_LLAMA_STACK_BASE_URL=http://localhost:8321

# OpenAI-compatible API
OPENGAUSS_RAGFLOW_OPENAI_BASE_URL=http://localhost:8000/v1
OPENGAUSS_RAGFLOW_OPENAI_API_KEY=
OPENGAUSS_RAGFLOW_OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENGAUSS_RAGFLOW_OPENAI_TIMEOUT_SECONDS=180
OPENGAUSS_RAGFLOW_OPENAI_TEMPERATURE=0.2
OPENGAUSS_RAGFLOW_OPENAI_MAX_TOKENS=512

# MinerU API
OPENGAUSS_RAGFLOW_MINERU_BASE_URL=https://mineru.net
OPENGAUSS_RAGFLOW_MINERU_API_TOKEN=
OPENGAUSS_RAGFLOW_MINERU_USER_TOKEN=
OPENGAUSS_RAGFLOW_MINERU_MODEL_VERSION=vlm
OPENGAUSS_RAGFLOW_MINERU_HTML_MODEL_VERSION=MinerU-HTML
OPENGAUSS_RAGFLOW_MINERU_LANGUAGE=auto
OPENGAUSS_RAGFLOW_MINERU_ENABLE_FORMULA=true
OPENGAUSS_RAGFLOW_MINERU_ENABLE_TABLE=true
OPENGAUSS_RAGFLOW_MINERU_ENABLE_OCR=false
OPENGAUSS_RAGFLOW_MINERU_TIMEOUT_SECONDS=60
OPENGAUSS_RAGFLOW_MINERU_POLL_INTERVAL_SECONDS=2
OPENGAUSS_RAGFLOW_MINERU_POLL_TIMEOUT_SECONDS=300

# App defaults
OPENGAUSS_RAGFLOW_DEFAULT_PROVIDER_ID=remote::pgvector
OPENGAUSS_RAGFLOW_DEFAULT_CHUNK_SIZE=512
OPENGAUSS_RAGFLOW_DEFAULT_RETRIEVAL_K=6
OPENGAUSS_RAGFLOW_DEFAULT_CHAT_K=5
OPENGAUSS_RAGFLOW_DEFAULT_MODE=hybrid
OPENGAUSS_RAGFLOW_DEFAULT_RANKER=rrf
OPENGAUSS_RAGFLOW_DEFAULT_RANKER_ALPHA=0.6
OPENGAUSS_RAGFLOW_DEFAULT_RANKER_IMPACT_FACTOR=60
OPENGAUSS_RAGFLOW_PGVECTOR_HOST=localhost
OPENGAUSS_RAGFLOW_PGVECTOR_PORT=5432
OPENGAUSS_RAGFLOW_PGVECTOR_DB=postgres
OPENGAUSS_RAGFLOW_PGVECTOR_USER=postgres
OPENGAUSS_RAGFLOW_PGVECTOR_PASSWORD=
OPENGAUSS_RAGFLOW_PGVECTOR_CONNECT_TIMEOUT=5
OPENGAUSS_RAGFLOW_CATALOG_PATH=opengauss_ragflow_app/data/catalog.json
