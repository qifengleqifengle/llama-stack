# Storage paths used by Llama Stack starter distro
SQLITE_STORE_DIR=~/.llama/distributions/opengauss-add
FILES_STORAGE_DIR=~/.llama/distributions/opengauss-add/files

# OpenAI-compatible provider used by Llama Stack for model/embedding access
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
LLAMA_STACK_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LLAMA_STACK_EMBEDDING_DIMENSION=1024

# PGVector provider for remote::pgvector
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=postgres
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=
PGVECTOR_CONNECT_TIMEOUT=5
PGVECTOR_FTS_CONFIG=simple

# Optional starter distro extras
TELEMETRY_SINKS=console,sqlite
BRAVE_SEARCH_API_KEY=
TAVILY_SEARCH_API_KEY=
